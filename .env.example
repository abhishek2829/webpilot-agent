# ============================================================
# WebPilot Agent — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- LLM (Option A+C: API key with minimal calls) ---
# Get your API key from: https://console.anthropic.com/settings/keys
# Add $5 credit — lasts months because CSS selectors handle 90% of cases.
# The LLM vision is only called as a rare fallback when selectors fail.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Database ---
DATABASE_URL=postgresql+asyncpg://webpilot:webpilot@localhost:5432/webpilot
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Credential Vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=your-fernet-key-here

# --- Browser ---
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=100          # ms between actions (helps debugging)
BROWSER_TIMEOUT=30000         # ms — max wait for selectors

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# --- Checkpoint Settings ---
CHECKPOINT_MODE=cli            # cli | websocket | auto
CHECKPOINT_TIMEOUT=300         # seconds to wait for human response

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console
SCREENSHOT_DIR=./data/screenshots
